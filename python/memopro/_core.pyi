# EDR codec for bf16 (0308, 0315; buffers are borrowed through the buffer protocol, RS2)
def edr_table(src: Any) -> bytes: ...
def edr_encode(src: Any, table: bytes, base: Any, resid: Any) -> tuple[bytes, bytes]: ...
def edr_decode(
    base: Any, resid: Any | None, table: bytes, esc_index: bytes, esc_bits: bytes, out: Any
) -> None: ...
def edr2_encode(src: Any) -> tuple[bytes, bytes, bytes, bytes, bytes]: ...
def edr2_decode(
    lens: bytes, offsets: bytes, exps: bytes, hi: bytes, lo: bytes | None, out: Any
) -> None: ...

# CSV kernels for memopro.sort / memopro.join (E069, 0357): int64 arrays are NumPy int64
def csv_count_rows(block: Buffer) -> int: ...
def csv_cut(block: Buffer) -> int: ...
def csv_fixed(src: Buffer, starts: Any, ends: Any, width: int, out: Buffer) -> int: ...
def csv_rows(
